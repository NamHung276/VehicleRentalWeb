@model IEnumerable<VehicleRentalWeb.Models.Rental>
@{
    ViewData["Title"] = "Rental Management";
}

<div class="container mt-4">
    <h2>Rental Management</h2>

    <a asp-action="Create" class="btn btn-primary mb-3">+ Create Rental</a>
    <a asp-action="Archived" class="btn btn-outline-danger mb-3 ms-2">
        <i class="bi bi-archive-fill me-1"></i> View Archived
    </a>

    <table class="table table-bordered table-striped align-middle">
        <thead class="table-dark">
            <tr>
                <th>Rental ID</th>
                <th>Customer</th>
                <th>Vehicle</th>
                <th>Start</th>
                <th>End</th>
                <th>Total Cost</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model)
            {
                <tr>
                    <td>@r.Id</td>
                    <td>@r.Customer?.Name</td>
                    <td>@r.Vehicle?.Make @r.Vehicle?.Model</td>
                    <td>@r.StartDate.ToShortDateString()</td>
                    <td>@r.EndDate.ToShortDateString()</td>
                    <td>@r.TotalCost.ToString("C")</td>

                    <td>
                        <a asp-action="Details" asp-route-id="@r.Id"
                           class="btn btn-sm btn-info">Details</a>

                        <a asp-action="Edit" asp-route-id="@r.Id"
                           class="btn btn-sm btn-warning">Edit</a>

                        <a asp-action="Delete" asp-route-id="@r.Id"
                           class="btn btn-sm btn-danger"
                           onclick="return confirm('Archive this rental?');">
                            Delete
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
