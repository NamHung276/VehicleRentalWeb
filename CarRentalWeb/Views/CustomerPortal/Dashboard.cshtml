@model IEnumerable<VehicleRentalWeb.Models.Rental>
@{
    Layout = "_CustomerLayout";
    ViewData["Title"] = "My Rentals";
}

<h2>My Rentals</h2>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}

<table class="table table-striped">
    <thead>
        <tr>
            <th>Vehicle</th>
            <th>Start</th>
            <th>End</th>
            <th>Status</th>
            <th>Rental Fee</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var r in Model)
        {
            <tr>
                <td>@(r.Vehicle != null ? $"{r.Vehicle.Make} {r.Vehicle.Model} ({r.Vehicle.Year})" : "—")</td>
                <td>@r.StartDate.ToShortDateString()</td>
                <td>@r.EndDate.ToShortDateString()</td>
                <td>
                    @switch (r.Status)
                    {
                        case VehicleRentalWeb.Models.RentalStatus.Pending:
                            @:<span class="badge bg-warning text-dark">Pending</span>;
                            break;
                        case VehicleRentalWeb.Models.RentalStatus.Approved:
                            @:<span class="badge bg-success">Approved</span>;
                            break;
                        case VehicleRentalWeb.Models.RentalStatus.Rejected:
                            @:<span class="badge bg-danger">Rejected</span>;
                            break;
                    }
                </td>
                <td>@r.RentalFee.ToString("C")</td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="BrowseVehicles" class="btn btn-primary">Browse Vehicles</a>
