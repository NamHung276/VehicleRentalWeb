@model IEnumerable<VehicleRentalWeb.Models.Vehicle>

@{
    ViewData["Title"] = "Browse Vehicles";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<h2>Available Vehicles</h2>

<div class="row mt-3">
    @foreach (var v in Model)
    {
        <div class="col-md-4 mb-3">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h4>@v.Make @v.Model</h4>
                    <p>@v.Year</p>
                    <a asp-action="VehicleDetails" asp-route-id="@v.Id" class="btn btn-primary">View</a>
                </div>
            </div>
        </div>
    }
</div>
