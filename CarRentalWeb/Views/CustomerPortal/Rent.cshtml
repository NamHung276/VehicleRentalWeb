@model VehicleRentalWeb.Models.Rental
@{
    Layout = "_CustomerLayout";
    ViewData["Title"] = "Request Rental";
}

<h2>Request Rental</h2>

<div class="row">
    <div class="col-md-8">
        <form asp-action="Rent" method="post">
            <input type="hidden" asp-for="VehicleId" />
            <div class="mb-3">
                <label>Vehicle</label>
                <input class="form-control" value="@Model.Vehicle?.Make @Model.Vehicle?.Model" disabled />
            </div>

            <div class="mb-3">
                <label asp-for="StartDate"></label>
                <input asp-for="StartDate" class="form-control" type="date" />
                <span asp-validation-for="StartDate" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="EndDate"></label>
                <input asp-for="EndDate" class="form-control" type="date" />
                <span asp-validation-for="EndDate" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="RentalFee">Estimated fee (calculated)</label>
                <input class="form-control" value="@(Model.Vehicle != null ? (Model.Vehicle.RatePerDay * ((Model.EndDate - Model.StartDate).Days > 0 ? (Model.EndDate - Model.StartDate).Days : 1)).ToString("C") : Model.RentalFee.ToString("C"))" disabled />
            </div>

            <button class="btn btn-primary">Submit Request</button>
        </form>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
