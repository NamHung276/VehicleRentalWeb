@model CustomerProfileViewModel

<h2>My Profile</h2>

<div class="card p-3 shadow-sm">
    <p><strong>Name:</strong> @Model.DisplayName</p>
    <p><strong>Email:</strong> @Model.Email</p>
    <p><strong>Phone:</strong> @Model.PhoneNumber</p>
    <p><strong>Address:</strong> @Model.Address</p>

    <a class="btn btn-primary mt-3" href="/CustomerPortal/EditProfile">Edit Profile</a>
</div>
