@model VehicleRentalWeb.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Register";
}

<h2>Register</h2>

<form asp-action="Register" method="post">

    <!-- SHOW IDENTITY ERRORS -->
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="DisplayName"></label>
        <input asp-for="DisplayName" class="form-control" />
        <span asp-validation-for="DisplayName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Email"></label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Password"></label>
        <input asp-for="Password" id="passwordInput" type="password" autocomplete="new-password" class="form-control" />
        <span asp-validation-for="Password" class="text-danger"></span>

        <!-- PASSWORD REQUIREMENT CHECKLIST -->
        <ul class="mt-2 small" id="passwordRules" style="list-style:none; padding-left:0;">
            <li id="rule-length" class="text-danger">✘ At least 6 characters</li>
            <li id="rule-lower" class="text-danger">✘ At least one lowercase letter</li>
            <li id="rule-upper" class="text-danger">✘ At least one uppercase letter</li>
            <li id="rule-number" class="text-danger">✘ At least one number</li>
            <!-- NO SYMBOL RULE because RequireNonAlphanumeric = false -->
        </ul>

        <!-- PASSWORD STRENGTH INDICATOR -->
        <small id="passwordStrength" class="fw-bold"></small>
    </div>

    <div class="mb-3">
        <label asp-for="ConfirmPassword"></label>
        <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" class="form-control" />
        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Phone"></label>
        <input asp-for="Phone" class="form-control" />
        <span asp-validation-for="Phone" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Address"></label>
        <input asp-for="Address" class="form-control" />
        <span asp-validation-for="Address" class="text-danger"></span>
    </div>

    <button class="btn btn-primary">Register</button>
</form>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script>

        const pwd = document.getElementById("passwordInput");
        const strengthText = document.getElementById("passwordStrength");

        // RULE ELEMENTS WITH FIXED LABELS
        const rules = {
            length: { el: document.getElementById("rule-length"), label: "At least 6 characters" },
            lower:  { el: document.getElementById("rule-lower"),  label: "At least one lowercase letter" },
            upper:  { el: document.getElementById("rule-upper"),  label: "At least one uppercase letter" },
            number: { el: document.getElementById("rule-number"), label: "At least one number" }
        };

        pwd.addEventListener("input", function () {
            const v = pwd.value;

            updateRule(rules.length.el, rules.length.label, v.length >= 6);
            updateRule(rules.lower.el, rules.lower.label, /[a-z]/.test(v));
            updateRule(rules.upper.el, rules.upper.label, /[A-Z]/.test(v));
            updateRule(rules.number.el, rules.number.label, /[0-9]/.test(v));

            // Update strength meter
            strengthText.textContent = getStrength(v);
            strengthText.style.color = getStrengthColor(v);
        });

        function updateRule(element, label, passed) {
            element.textContent = (passed ? "✔ " : "✘ ") + label;
            element.className = passed ? "text-success" : "text-danger";
        }

        function getStrength(p) {
            if (p.length === 0) return "";

            let score = 0;
            if (p.length >= 6) score++;
            if (/[A-Z]/.test(p)) score++;
            if (/[a-z]/.test(p)) score++;
            if (/[0-9]/.test(p)) score++;

            return ["Very Weak", "Weak", "Medium", "Strong", "Very Strong"][score];
        }

        function getStrengthColor(p) {
            let score = 0;
            if (p.length >= 6) score++;
            if (/[A-Z]/.test(p)) score++;
            if (/[a-z]/.test(p)) score++;
            if (/[0-9]/.test(p)) score++;

            return ["red", "orangered", "gold", "green", "darkgreen"][score];
        }

    </script>
}

