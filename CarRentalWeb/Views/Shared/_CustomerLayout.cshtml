@using Microsoft.AspNetCore.Identity
@using VehicleRentalWeb.Models
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Customer Portal</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>
    <nav class="navbar navbar-expand-sm navbar-dark bg-primary mb-3">
        <div class="container">

            <a class="navbar-brand" asp-controller="CustomerPortal" asp-action="Home">
                Customer Portal
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#customerNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="customerNav">
                <ul class="navbar-nav me-auto">

                    @{
                        bool isAuth = User?.Identity?.IsAuthenticated ?? false;
                        bool isCustomer = User?.IsInRole("Customer") ?? false;
                    }

                    @if (isAuth && isCustomer)
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="CustomerPortal" asp-action="Home">Home</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="CustomerPortal" asp-action="MyRentals">My Rentals</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="CustomerPortal" asp-action="BrowseVehicles">Browse Vehicles</a>
                        </li>
                    }
                </ul>

                <ul class="navbar-nav ms-auto">
                    @if (isAuth)
                    {
                        <li class="nav-item me-2">
                            <span class="navbar-text text-white">
                                @(User?.Identity?.Name ?? "User")
                            </span>
                        </li>

                        <li class="nav-item">
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-light btn-sm">Logout</button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Login">Login</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Register">Register</a>
                        </li>
                    }
                </ul>
            </div>

        </div>
    </nav>

    <div class="container">
        <main class="mt-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted text-center mt-4">
        <div class="container">
            &copy; @DateTime.Now.Year - Vehicle Rental Web
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
