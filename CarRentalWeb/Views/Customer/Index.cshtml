@model IEnumerable<VehicleRentalWeb.Models.Customer>

@{
    ViewData["Title"] = "Customer List";
}

<div class="container mt-4">
    <h2 class="text-center mb-4 fw-bold text-primary">
        <i class="bi bi-people-fill me-2"></i>@ViewData["Title"]
    </h2>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success text-center">@TempData["Message"]</div>
    }

    <div class="text-center mb-4">
        <a asp-action="Create" class="btn btn-success btn-lg me-2">
            <i class="bi bi-person-plus"></i> Add New Customer
        </a>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-lg">
            <i class="bi bi-house-door"></i> Home
        </a>
    </div>

    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var c in Model)
        {
            <div class="col">
                <div class="card shadow border-0 h-100">
                    <img src="@(string.IsNullOrEmpty(c.ImagePath) ? "/images/default_customer.jpg" : c.ImagePath)"
                         class="card-img-top" style="object-fit:cover;height:220px;" alt="@c.Name" />
                    <div class="card-body text-center">
                        <h5 class="card-title fw-bold text-primary">@c.Name</h5>
                        <p class="text-muted">@c.Email</p>
                        <p>@c.Phone</p>
                        <p class="text-muted small">@c.Address</p>
                    </div>
                    <div class="card-footer text-center bg-white border-0 pb-3">
                        <a asp-controller="Customer" asp-action="Details" asp-route-id="@c.Id" class="btn btn-outline-primary btn-sm me-2">
                            <i class="bi bi-eye"></i> View
                        </a>
                        <a asp-controller="Customer" asp-action="Edit" asp-route-id="@c.Id" class="btn btn-outline-warning btn-sm me-2">
                            <i class="bi bi-pencil"></i> Edit
                        </a>
                        <a asp-controller="Customer" asp-action="Delete" asp-route-id="@c.Id" class="btn btn-outline-danger btn-sm">
                            <i class="bi bi-trash"></i> Delete
                        </a>
                    </div>

                </div>
            </div>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center mt-5">
            <i class="bi bi-person-x"></i> No customers found.
        </div>
    }
</div>
