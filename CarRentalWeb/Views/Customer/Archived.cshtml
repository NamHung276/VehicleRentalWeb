@model IEnumerable<VehicleRentalWeb.Models.Customer>

@{
    ViewData["Title"] = "Archived Customers";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="fw-bold text-danger mb-0">
            <i class="bi bi-archive-fill me-2"></i>Archived Customers
        </h2>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left-circle me-1"></i> Back to Customers
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-secondary text-center py-5">
            <i class="bi bi-inbox fs-1 mb-3 text-muted"></i>
            <h5>No archived customers found.</h5>
            <a asp-action="Index" class="btn btn-primary mt-3">Return to Customers</a>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-3 g-4">
            @foreach (var c in Model)
            {
                <div class="col">
                    <div class="card border-danger shadow-sm h-100">

                        <div class="card-body">
                            <h5 class="fw-bold text-danger">@c.Name</h5>
                            <p class="text-muted small">
                                <strong>Email:</strong> @c.Email<br />
                                <strong>Phone:</strong> @c.Phone
                            </p>
                        </div>

                        <div class="card-footer d-flex justify-content-between bg-light">
                            <form asp-action="Restore" asp-route-id="@c.Id" method="post">
                                <button type="submit" class="btn btn-sm btn-success">
                                    <i class="bi bi-arrow-counterclockwise me-1"></i>Restore
                                </button>
                            </form>

                            <form asp-action="DeletePermanent" asp-route-id="@c.Id" method="post"
                                  onsubmit="return confirm('⚠ This will permanently delete this customer. Continue?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash me-1"></i>Delete
                                </button>
                            </form>
                        </div>

                    </div>
                </div>
            }
        </div>
    }
</div>
