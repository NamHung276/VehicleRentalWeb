@model VehicleRentalWeb.Models.Customer
@{
    ViewData["Title"] = "Delete Customer";
}

<h2>Delete Customer</h2>

<hr />

<div class="alert alert-danger">
    <h4>Are you sure you want to archive this customer?</h4>
    <p>This action will NOT permanently delete the customer. They will be marked as archived.</p>
</div>

<div class="mb-3">
    <strong>Name:</strong> @Model.Name<br />
    <strong>Email:</strong> @Model.Email<br />
    <strong>Phone:</strong> @Model.Phone<br />
    <strong>Address:</strong> @Model.Address
</div>

<form asp-action="DeleteConfirmed" method="post">
    <input type="hidden" asp-for="Id" />

    <button type="submit" class="btn btn-danger">
        <i class="bi bi-archive"></i> Archive Customer
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancel
    </a>
</form>
