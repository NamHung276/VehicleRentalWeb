@model VehicleRentalWeb.Models.Rental

@{
    ViewData["Title"] = "Add New Rental";
}

<h2 class="mb-4">@ViewData["Title"]</h2>

<div class="card shadow p-4">
    <form asp-action="Create" method="post" class="needs-validation" novalidate>
        <div class="row">
            <!-- Customer -->
            <div class="col-md-6 mb-3">
                <label class="form-label">Select Customer</label>
                <select asp-for="CustomerId" class="form-select" asp-items="ViewBag.Customers">
                    <option value="">-- Choose a customer --</option>
                </select>
                <span asp-validation-for="CustomerId" class="text-danger"></span>
            </div>

            <!-- Vehicle -->
            <div class="col-md-6 mb-3">
                <label class="form-label">Select Vehicle</label>
                <select asp-for="VehicleId" class="form-select" asp-items="ViewBag.Vehicles">
                    <option value="">-- Choose a vehicle --</option>
                </select>
                <span asp-validation-for="VehicleId" class="text-danger"></span>
            </div>
        </div>

        <!-- Dates -->
        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="StartDate" class="form-label"></label>
                <input asp-for="StartDate" type="date" class="form-control" />
                <span asp-validation-for="StartDate" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="EndDate" class="form-label"></label>
                <input asp-for="EndDate" type="date" class="form-control" />
                <span asp-validation-for="EndDate" class="text-danger"></span>
            </div>
        </div>

        <!-- Cost -->
        <div class="mb-3">
            <label asp-for="TotalCost" class="form-label"></label>
            <input asp-for="TotalCost" class="form-control" placeholder="e.g. 250.00" />
            <span asp-validation-for="TotalCost" class="text-danger"></span>
        </div>

        <div class="d-flex justify-content-end">
            <a asp-action="Index" class="btn btn-secondary me-2">Cancel</a>
            <button class="btn btn-primary" type="submit">Save Rental</button>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
