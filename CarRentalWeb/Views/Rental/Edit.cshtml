@model VehicleRentalWeb.Models.Rental

@{
    ViewData["Title"] = "Edit Rental";
}

<h2 class="text-center mb-4">@ViewData["Title"]</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />

    <div class="card shadow p-4">
        <!-- Customer -->
        <div class="mb-3">
            <label class="form-label">Customer</label>
            <select asp-for="CustomerId" class="form-select" asp-items="ViewBag.Customers"></select>
        </div>

        <!-- Vehicle -->
        <div class="mb-3">
            <label class="form-label">Vehicle</label>
            <select asp-for="VehicleId" class="form-select" asp-items="ViewBag.Vehicles"></select>
        </div>

        <!-- Start Date -->
        <div class="mb-3">
            <label asp-for="StartDate" class="form-label"></label>
            <input asp-for="StartDate" type="date" class="form-control" />
        </div>

        <!-- End Date -->
        <div class="mb-3">
            <label asp-for="EndDate" class="form-label"></label>
            <input asp-for="EndDate" type="date" class="form-control" />
        </div>

        <!-- Total Cost -->
        <div class="mb-3">
            <label asp-for="TotalCost" class="form-label"></label>
            <input asp-for="TotalCost" class="form-control" />
        </div>

        <div class="text-center mt-4">
            <button type="submit" class="btn btn-success">Save Changes</button>
            <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
        </div>
    </div>
</form>
