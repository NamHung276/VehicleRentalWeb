@model VehicleRentalWeb.Models.Rental

@{
    ViewData["Title"] = "Edit Rental";
}

<div class="container mt-4">
    <h2 class="text-center fw-bold text-primary mb-4">
        <i class="bi bi-pencil-square me-2"></i>Edit Rental
    </h2>

    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />

        <div class="card shadow p-4">

            <!-- Customer -->
            <div class="mb-3">
                <label class="form-label fw-bold">Customer</label>
                <select asp-for="CustomerId" class="form-select">
                    @foreach (var c in ViewBag.Customers)
                    {
                        <option value="@c.Id" selected="@(c.Id == Model.CustomerId)">
                            @c.Name
                        </option>
                    }
                </select>
            </div>

            <!-- Vehicle -->
            <div class="mb-3">
                <label class="form-label fw-bold">Vehicle</label>
                <select asp-for="VehicleId" class="form-select">
                    @foreach (var v in ViewBag.Vehicles)
                    {
                        <option value="@v.Id" selected="@(v.Id == Model.VehicleId)">
                            @v.Display
                        </option>
                    }
                </select>
            </div>

            <!-- Enum Source -->
            <div class="mb-3">
                <label asp-for="Source" class="form-label fw-bold"></label>
                <select asp-for="Source" class="form-select"
                        asp-items="Html.GetEnumSelectList<VehicleRentalWeb.Models.RentalSource>()"></select>
            </div>

            <!-- Start Date -->
            <div class="mb-3">
                <label asp-for="StartDate" class="form-label fw-bold"></label>
                <input asp-for="StartDate" type="date" class="form-control" />
            </div>

            <!-- End Date -->
            <div class="mb-3">
                <label asp-for="EndDate" class="form-label fw-bold"></label>
                <input asp-for="EndDate" type="date" class="form-control" />
            </div>

            <!-- Cost -->
            <div class="mb-3">
                <label asp-for="TotalCost" class="form-label fw-bold"></label>
                <input asp-for="TotalCost" class="form-control" />
            </div>

            <div class="text-center mt-4">
                <button type="submit" class="btn btn-success px-4">
                    <i class="bi bi-save me-1"></i>Save Changes
                </button>
                <a asp-action="Index" class="btn btn-secondary ms-2 px-4">Cancel</a>
            </div>

        </div>
    </form>
</div>
