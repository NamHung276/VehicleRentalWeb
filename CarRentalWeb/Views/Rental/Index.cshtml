@model IEnumerable<VehicleRentalWeb.Models.Rental>

@{
    ViewData["Title"] = "Rental Transactions";
}

<div class="container mt-4">
    <h2 class="text-center mb-4 fw-bold text-primary">
        <i class="bi bi-card-checklist me-2"></i>@ViewData["Title"]
    </h2>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show text-center" role="alert">
            <i class="bi bi-check-circle me-1"></i> @TempData["Message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="text-center mb-4">
        <a asp-controller="Rental" asp-action="Create" class="btn btn-success btn-lg me-2">
            <i class="bi bi-plus-circle"></i> Add New Rental
        </a>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-lg me-2">
            <i class="bi bi-house-door"></i> Back to Home
        </a>
        <a asp-action="Archived" class="btn btn-outline-secondary btn-lg">
            <i class="bi bi-archive"></i> View Archived
        </a>
    </div>

    <table class="table table-striped table-hover align-middle shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Customer</th>
                <th>Vehicle</th>
                <th>Rental Source</th>
                <th>Start Date</th>
                <th>End Date</th>
                <th>Total Cost ($)</th>
                <th>Status</th>
                <th class="text-center">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var rental in Model)
            {
                <tr>
                    <td>@rental.Id</td>
                    <td>@rental.Customer?.Name</td>
                    <td>@rental.Vehicle?.Model</td>
                    <td>@rental.Source</td>
                    <td>@rental.StartDate.ToShortDateString()</td>
                    <td>@rental.EndDate.ToShortDateString()</td>
                    <td>@rental.TotalCost.ToString("0.00")</td>
                    <td>
                        @if (rental.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Completed</span>
                        }
                    </td>
                    <td class="text-center">
                        <a asp-controller="Rental" asp-action="Details" asp-route-id="@rental.Id" class="btn btn-sm btn-outline-primary me-1">
                            <i class="bi bi-eye"></i> View
                        </a>
                        <a asp-controller="Rental" asp-action="Delete" asp-route-id="@rental.Id" class="btn btn-sm btn-outline-danger me-1">
                            <i class="bi bi-trash"></i> Delete
                        </a>

                        @if (!rental.IsArchived)
                        {
                            <form asp-action="Archive" asp-route-id="@rental.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-secondary" title="Archive">
                                    <i class="bi bi-archive"></i> Archive
                                </button>
                            </form>
                        }
                        else
                        {
                            <form asp-action="Unarchive" asp-route-id="@rental.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-success" title="Restore">
                                    <i class="bi bi-box-arrow-in-down"></i> Restore
                                </button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center mt-5">
            <i class="bi bi-folder-x"></i> No rental records available.
        </div>
    }
</div>
