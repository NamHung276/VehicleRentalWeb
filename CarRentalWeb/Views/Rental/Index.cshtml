@model IEnumerable<VehicleRentalWeb.Models.Rental>
@{
    ViewData["Title"] = "Rental Management";
}

<div class="container mt-4">
    <h2>Rental Management</h2>

    <table class="table table-bordered table-striped align-middle">
        <thead class="table-dark">
            <tr>
                <th>Rental ID</th>
                <th>Customer</th>
                <th>Vehicle</th>
                <th>Start</th>
                <th>End</th>
                <th>Total Cost</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model)
            {
                <tr>
                    <td>@r.Id</td>
                    <td>@r.Customer?.Name</td>
                    <td>@r.Vehicle?.Make @r.Vehicle?.Model</td>
                    <td>@r.StartDate.ToShortDateString()</td>
                    <td>@r.EndDate.ToShortDateString()</td>
                    <td>@r.TotalCost.ToString("C")</td>
                    <td>@r.Status</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@r.Id" class="btn btn-sm btn-info">Details</a>

                        @if (r.Status == VehicleRentalWeb.Models.RentalStatus.Pending)
                        {
                            <a asp-action="Approve" asp-route-id="@r.Id" class="btn btn-sm btn-success">Approve</a>
                            <a asp-action="Reject" asp-route-id="@r.Id" class="btn btn-sm btn-danger"
                               onclick="return confirm('Reject this rental?');">Reject</a>
                        }
                        else
                        {
                            <span class="badge bg-secondary">@r.Status</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
