@model VehicleRentalWeb.Models.Rental

@{
    ViewData["Title"] = "Rental Details";
}

<h2 class="fw-bold mb-3">@ViewData["Title"]</h2>

<div class="card shadow p-4">
    <div class="row g-4">
        <div class="col-md-6">
            <h4>Rental Summary</h4>
            <p><strong>ID:</strong> #@Model.Id</p>
            <p><strong>Customer:</strong> @Model.Customer?.Name</p>
            <p><strong>Vehicle:</strong> @Model.Vehicle?.Make @Model.Vehicle?.Model</p>
            <p><strong>Start Date:</strong> @Model.StartDate.ToShortDateString()</p>
            <p><strong>End Date:</strong> @Model.EndDate.ToShortDateString()</p>
            <p><strong>Status:</strong> @(Model.IsActive ? "Active" : "Completed")</p>
        </div>

        <div class="col-md-6">
            <h4>Payment Info</h4>
            <p><strong>Total Cost:</strong> $@Model.TotalCost.ToString("0.00")</p>
            <p><strong>Payment Status:</strong> @Model.PaymentStatus</p>
        </div>
    </div>

    <div class="mt-4 text-end">
        <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
    </div>
</div>
