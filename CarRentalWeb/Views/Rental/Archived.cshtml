@model IEnumerable<VehicleRentalWeb.Models.Rental>

@{
    ViewData["Title"] = "Archived Rentals";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="fw-bold text-danger mb-0">
            <i class="bi bi-archive-fill me-2"></i>Archived Rentals
        </h2>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left-circle me-1"></i> Back to Rentals
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-secondary text-center py-5">
            <i class="bi bi-inbox fs-1 mb-3 text-muted"></i>
            <h5>No archived rentals found.</h5>
            <a asp-action="Index" class="btn btn-primary mt-3">Return to Rentals</a>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-3 g-4">
            @foreach (var r in Model)
            {
                <div class="col">
                    <div class="card border-danger shadow-sm h-100">

                        <div class="card-body">
                            <h5 class="fw-bold text-danger">Rental #@r.Id</h5>

                            <p class="text-muted small">
                                <strong>Customer:</strong>
                                @(r.Customer != null ? r.Customer.Name : "Unknown Customer") <br />

                                <strong>Vehicle:</strong>
                                @(r.Vehicle != null
                                                        ? $"{r.Vehicle.Make} {r.Vehicle.Model}"
                                                        : "Unknown Vehicle") <br />

                        <strong>Start:</strong> @r.StartDate.ToShortDateString() <br />
                        <strong>End:</strong> @r.EndDate.ToShortDateString()
                    </p>
                </div>

                        <div class="card-footer d-flex justify-content-between bg-light">
                            <form asp-action="Restore" asp-route-id="@r.Id" method="post">
                                <button type="submit" class="btn btn-sm btn-success">
                                    <i class="bi bi-arrow-counterclockwise me-1"></i>Restore
                                </button>
                            </form>

                            <form asp-action="DeletePermanent" asp-route-id="@r.Id" method="post"
                                  onsubmit="return confirm('⚠ This will permanently delete this rental. Continue?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash me-1"></i>Delete
                                </button>
                            </form>
                        </div>

                    </div>
                </div>
                }
        </div>
    }
</div>
