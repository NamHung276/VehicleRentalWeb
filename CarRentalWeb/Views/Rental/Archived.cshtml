@model IEnumerable<VehicleRentalWeb.Models.Rental>

@{
    ViewData["Title"] = "Archived Rentals";
}

<h2 class="text-center mb-4 fw-bold text-primary">
    <i class="bi bi-archive me-2"></i>@ViewData["Title"]
</h2>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success alert-dismissible fade show text-center" role="alert">
        <i class="bi bi-check-circle me-1"></i> @TempData["Message"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="text-center mb-4">
    <a asp-action="Index" class="btn btn-outline-primary btn-lg me-2">
        <i class="bi bi-arrow-left"></i> Back to Rentals
    </a>
</div>

<table class="table table-striped table-hover align-middle shadow-sm">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Customer</th>
            <th>Vehicle</th>
            <th>Rental Source</th>
            <th>Start Date</th>
            <th>End Date</th>
            <th>Total Cost ($)</th>
            <th>Status</th>
            <th class="text-center">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var rental in Model)
        {
            <tr>
                <td>@rental.Id</td>
                <td>@rental.Customer?.Name</td>
                <td>@rental.Vehicle?.Model</td>
                <td>@rental.Source</td>
                <td>@rental.StartDate.ToShortDateString()</td>
                <td>@rental.EndDate.ToShortDateString()</td>
                <td>@rental.TotalCost.ToString("0.00")</td>
                <td>
                    @if (rental.IsActive)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Completed</span>
                    }
                </td>
                <td class="text-center">
                    <form asp-action="Restore" asp-route-id="@rental.Id" method="post" class="d-inline">
                        <button type="submit" class="btn btn-outline-success btn-sm">
                            <i class="bi bi-arrow-counterclockwise"></i> Restore
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <div class="alert alert-info text-center mt-5">
        <i class="bi bi-folder-x"></i> No archived rentals found.
    </div>
}
