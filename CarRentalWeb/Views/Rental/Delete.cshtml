@model VehicleRentalWeb.Models.Rental
@{
    ViewData["Title"] = "Delete Rental";
}

<h2>Delete Rental</h2>

<hr />

<div class="alert alert-danger">
    <h4>Are you sure you want to archive this rental?</h4>
    <p>This will not permanently delete it. The rental will simply be marked as archived.</p>
</div>

<div class="mb-3">
    <strong>Customer:</strong> @Model.Customer?.Name<br />
    <strong>Vehicle:</strong> @Model.Vehicle?.Model<br />
    <strong>Start Date:</strong> @Model.StartDate.ToShortDateString()<br />
    <strong>End Date:</strong> @Model.EndDate.ToShortDateString()<br />
    <strong>Total Cost:</strong> $@Model.TotalCost
</div>

<form asp-action="DeleteConfirmed" method="post">
    <input type="hidden" asp-for="Id" />

    <button type="submit" class="btn btn-danger">
        <i class="bi bi-archive"></i> Archive Rental
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancel
    </a>
</form>
