@model VehicleRentalWeb.Models.Rental
@{
    ViewData["Title"] = "Delete Rental";
}

<div class="container mt-5">
    <h2 class="text-danger fw-bold text-center">
        <i class="bi bi-exclamation-triangle"></i> Delete Rental Record
    </h2>
    <hr />

    <div class="card shadow border-0 mx-auto" style="max-width: 600px;">
        <div class="card-body text-center">
            <h4>Rental ID: <span class="text-primary">@Model.Id</span></h4>
            <p><strong>Customer:</strong> @Model.Customer?.Name</p>
            <p><strong>Vehicle:</strong> @Model.Vehicle?.Model</p>
            <p><strong>Period:</strong> @Model.StartDate.ToShortDateString() - @Model.EndDate.ToShortDateString()</p>
            <p><strong>Total Cost:</strong> $@Model.TotalCost.ToString("0.00")</p>

            <div class="alert alert-danger mt-3">
                Are you sure you want to delete this rental record?
            </div>

            <form asp-action="DeleteConfirmed" method="post">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger btn-lg me-2">
                    <i class="bi bi-trash"></i> Delete
                </button>
                <a asp-action="Index" class="btn btn-secondary btn-lg">
                    <i class="bi bi-x-circle"></i> Cancel
                </a>
            </form>
        </div>
    </div>
</div>
