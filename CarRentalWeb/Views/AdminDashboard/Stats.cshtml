@{
    ViewData["Title"] = "Admin Stats";
}

<div class="container mt-4">
    <h2>Admin Statistics (from API)</h2>

    <div id="stats" class="mt-3">
        Loading stats...
    </div>
</div>

@section Scripts {
    <script>
        async function loadStats() {
            try {
                const response = await fetch('/api/admin/stats');
                if (!response.ok) throw new Error('API error');

                const data = await response.json();

                document.getElementById('stats').innerHTML = `
                    <ul class="list-group">
                        <li class="list-group-item">Total Vehicles: ${data.totalVehicles}</li>
                        <li class="list-group-item">Total Customers: ${data.totalCustomers}</li>
                        <li class="list-group-item">Total Rentals: ${data.totalRentals}</li>
                        <li class="list-group-item">Active Rentals: ${data.activeRentals}</li>
                    </ul>
                `;
            } catch (err) {
                document.getElementById('stats').innerHTML = '<span class="text-danger">Error loading stats</span>';
                console.error(err);
            }
        }

        loadStats();
    </script>
}
