@model VehicleRentalWeb.Models.Vehicle
@{
    ViewData["Title"] = "Edit Vehicle";
    string vehicleType = Model.GetType().Name;
}

<div class="container mt-4">
    <h2>Edit @vehicleType</h2>
    <hr />

    <form asp-action="Edit" method="post" enctype="multipart/form-data">
        <input type="hidden" name="Id" value="@Model.Id" />
        <input type="hidden" name="vehicleType" value="@vehicleType" />

        <div class="row">
            <div class="col-md-6">
                <div class="mb-3">
                    <label asp-for="Make" class="form-label"></label>
                    <input asp-for="Make" class="form-control" />
                </div>
                <div class="mb-3">
                    <label asp-for="Model" class="form-label"></label>
                    <input asp-for="Model" class="form-control" />
                </div>
                <div class="mb-3">
                    <label asp-for="Year" class="form-label"></label>
                    <input asp-for="Year" class="form-control" />
                </div>
                <div class="mb-3">
                    <label asp-for="Color" class="form-label"></label>
                    <input asp-for="Color" class="form-control" />
                </div>
            </div>

            <div class="col-md-6">
                <div class="mb-3">
                    <label asp-for="Supplier" class="form-label"></label>
                    <input asp-for="Supplier" class="form-control" />
                </div>
                <div class="mb-3">
                    <label asp-for="RatePerDay" class="form-label"></label>
                    <input asp-for="RatePerDay" class="form-control" />
                </div>
                <div class="mb-3">
                    <label asp-for="Status" class="form-label"></label>
                    <input asp-for="Status" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Upload Image</label>
                    <input type="file" name="ImageFile" class="form-control" />
                </div>
                @if (!string.IsNullOrEmpty(Model.ImagePath))
                {
                    <div class="mt-2">
                        <img src="@Model.ImagePath" alt="Current Image" class="img-thumbnail" style="max-width:150px;" />
                    </div>
                }
            </div>
        </div>

        <!-- Car Fields -->
        <input type="number" name="Seats" class="form-control" min="1" max="10"
               value="@(Model is Car carModel ? carModel.Seats : 4)" />

        <input type="text" name="Luggage" class="form-control"
               value="@(Model is Car carModelL ? carModelL.Luggage : "")" />

        <input type="text" name="Transmission" class="form-control"
               value="@(Model is Car carModelT ? carModelT.Transmission : "")" />

        <input type="checkbox" name="HasAC" class="form-check-input"
               @(Model is Car carModelAC && carModelAC.HasAC ? "checked" : "") />

        <input type="checkbox" name="HasCarPlay" class="form-check-input"
               @(Model is Car carModelCP && carModelCP.HasCarPlay ? "checked" : "") />

        <input type="text" name="FuelType" class="form-control"
               value="@(Model is Car carModelF ? carModelF.FuelType : "Fuel")" />

        <input type="text" name="MileagePolicy" class="form-control"
               value="@(Model is Car carModelM ? carModelM.MileagePolicy : "Unlimited")" />

        <!-- Bike Fields -->
        <input type="number" name="EngineCC" class="form-control"
               value="@(Model is Bike bikeE ? bikeE.EngineCC : 150)" />

        <input type="text" name="Transmission" class="form-control"
               value="@(Model is Bike bikeT ? bikeT.Transmission : "Manual")" />

        <input type="checkbox" name="IsElectric" class="form-check-input"
               @(Model is Bike bikeI && bikeI.IsElectric ? "checked" : "") />

        <!-- Truck Fields -->
        <input type="number" name="CapacityInTons" class="form-control" step="0.1"
               value="@(Model is Truck truckC ? truckC.CapacityInTons : 2.0)" />

        <input type="text" name="Transmission" class="form-control"
               value="@(Model is Truck truckT ? truckT.Transmission : "Manual")" />

        <input type="checkbox" name="HasAC" class="form-check-input"
               @(Model is Truck truckAC && truckAC.HasAC ? "checked" : "") />


        <button type="submit" class="btn btn-success mt-3">Save Changes</button>
        <a asp-action="Index" class="btn btn-secondary mt-3">Cancel</a>
    </form>
</div>

@section Scripts {
    <script>
        const type = "@vehicleType";
        const fields = document.querySelectorAll(".vehicle-fields");
        fields.forEach(f => f.classList.add("d-none"));

        if (type === "Car") document.getElementById("carFields").classList.remove("d-none");
        if (type === "Bike") document.getElementById("bikeFields").classList.remove("d-none");
        if (type === "Truck") document.getElementById("truckFields").classList.remove("d-none");
    </script>
}
