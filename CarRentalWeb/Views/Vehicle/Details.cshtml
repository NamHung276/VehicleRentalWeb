@model VehicleRentalWeb.Models.Vehicle
@{
    ViewData["Title"] = "Vehicle Details";
}

<div class="container mt-4">
    <h2>@Model.Make @Model.Model (@Model.Year)</h2>
    <hr />

    <div class="row">
        <div class="col-md-4">
            @if (!string.IsNullOrEmpty(Model.ImagePath))
            {
                <img src="@Model.ImagePath" class="img-fluid rounded shadow" />
            }
            else
            {
                <p class="text-muted">No image available</p>
            }
        </div>
        <div class="col-md-8">
            <p><strong>Type:</strong> @Model.GetType().Name</p>
            <p><strong>Color:</strong> @Model.Color</p>
            <p><strong>Supplier:</strong> @Model.Supplier</p>
            <p><strong>Rate/Day:</strong> @Model.RatePerDay.ToString("C")</p>
            <p><strong>Status:</strong> @Model.Status</p>
        </div>
    </div>

    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning mt-3">Edit</a>
    <a asp-action="Index" class="btn btn-secondary mt-3">Back</a>
</div>
