@model IEnumerable<VehicleRentalWeb.Models.Vehicle>
@{
    ViewData["Title"] = "All Vehicles";
}

<div class="container mt-4">
    <h2>Vehicle Management</h2>
    <a asp-action="Create" class="btn btn-primary mb-3">+ Add Vehicle</a>
    <a asp-action="Archived" class="btn btn-outline-danger mb-3 ms-2">
        <i class="bi bi-archive-fill me-1"></i> View Archived
    </a>

    <table class="table table-bordered table-striped align-middle">
        <thead class="table-dark">
            <tr>
                <th>Image</th>
                <th>Make</th>
                <th>Model</th>
                <th>Year</th>
                <th>Rate/Day</th>
                <th>Status</th>
                <th>Type</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var v in Model)
            {
                <tr>
                    <td>
                        @if (!string.IsNullOrEmpty(v.ImagePath))
                        {
                            <img src="@v.ImagePath" alt="Vehicle Image" width="100" class="rounded shadow" />
                        }
                        else
                        {
                            <span class="text-muted">No image</span>
                        }
                    </td>
                    <td>@v.Make</td>
                    <td>@v.Model</td>
                    <td>@v.Year</td>
                    <td>@v.RatePerDay.ToString("C")</td>
                    <td>@v.Status</td>
                    <td>@v.GetType().Name</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@v.Id" class="btn btn-sm btn-info">Details</a>
                        <a asp-action="Edit" asp-route-id="@v.Id" class="btn btn-sm btn-warning">Edit</a>
                        <a asp-action="Delete" asp-route-id="@v.Id" class="btn btn-sm btn-danger"
                           onclick="return confirm('Archive this vehicle?');">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
