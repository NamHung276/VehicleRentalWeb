@model VehicleRentalWeb.Models.Bike
@{
    ViewData["Title"] = "Edit Bike";
}

<div class="container mt-4">
    <h2>Edit Bike</h2>
    <hr />

    <form asp-action="EditBike" enctype="multipart/form-data" method="post">
        <input type="hidden" asp-for="Id" />

        <div class="row">
            <div class="col-md-6">
                <div class="mb-3">
                    <label asp-for="Make" class="form-label"></label>
                    <input asp-for="Make" class="form-control" />
                </div>
                <div class="mb-3">
                    <label asp-for="Model" class="form-label"></label>
                    <input asp-for="Model" class="form-control" />
                </div>
                <div class="mb-3">
                    <label asp-for="Year" class="form-label"></label>
                    <input asp-for="Year" class="form-control" />
                </div>
                <div class="mb-3">
                    <label asp-for="Color" class="form-label"></label>
                    <input asp-for="Color" class="form-control" />
                </div>
            </div>

            <div class="col-md-6">
                <div class="mb-3">
                    <label asp-for="Supplier" class="form-label"></label>
                    <input asp-for="Supplier" class="form-control" />
                </div>
                <div class="mb-3">
                    <label asp-for="RatePerDay" class="form-label"></label>
                    <input asp-for="RatePerDay" class="form-control" />
                </div>
                <div class="mb-3">
                    <label asp-for="Status" class="form-label"></label>
                    <input asp-for="Status" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Upload Image</label>
                    <input type="file" name="ImageFile" class="form-control" />
                    @if (!string.IsNullOrEmpty(Model.ImagePath))
                    {
                        <img src="@Model.ImagePath" alt="Bike Image" class="img-thumbnail mt-2" width="150" />
                    }
                </div>
            </div>
        </div>

        <h5>Bike Specifications</h5>
        <hr />
        <div class="row">
            <div class="col-md-3 mb-3">
                <label>Engine CC</label>
                <input type="number" name="EngineCC" class="form-control" value="@Model.EngineCC" />
            </div>
            <div class="col-md-3 mb-3">
                <label>Transmission</label>
                <input type="text" name="Transmission" class="form-control" value="@Model.Transmission" />
            </div>
            <div class="form-check">
                <input type="checkbox" asp-for="IsElectric" class="form-check-input" />
                <label class="form-check-label">Electric Bike</label>
            </div>
        </div>

        <button type="submit" class="btn btn-success mt-3">Save Changes</button>
        <a asp-action="Index" class="btn btn-secondary mt-3">Cancel</a>
    </form>
</div>
